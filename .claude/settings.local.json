{
  "model": "sonnet",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "env": {
    "MAX_THINKING_TOKENS": "16000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(rg:*)"
    ],
    "deny": [
      "Read(./.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  }
}
