        "trial_id",
        "action_id",
        "auth_ref",
        "actual_scene",
        "technical_request_ref"
      ],
      "not_run_state_rules": {
        "status": "NOT_RUN",
        "nullable_fields": ["technical_response", "executed_at"],
        "mandatory_fields_when_not_run": ["skip_or_abort_reason"]
      },
      "executed_state_rules": {
        "status": "EXECUTED",
        "mandatory_fields": ["technical_response", "executed_at"]
      }
