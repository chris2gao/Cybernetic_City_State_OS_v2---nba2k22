      "falsification_criteria": {
        "supported_condition": "delta(TEAM_PACE_NATIVE) >= +2.5 possessions/game AND delta(fastbreak_points) >= +2.5",
        "refuted_condition": "delta(TEAM_PACE_NATIVE) <= -1.0",
        "inconclusive_conditions": [
          "Average opponent defensive pace shifted by > 4.0 possessions across blocks",
          "Block overtime games > 20% skewing raw possession totals"
        ]
      }
