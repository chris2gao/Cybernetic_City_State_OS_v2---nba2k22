          }
        }
      ],
      "experimental_blocks": {
        "s0_baseline_block": {
          "block_name": "S0_CALENDAR_SIM_BASELINE",
          "game_count_minimum": 10,
          "simulation_filter": "s.was_simulated == 1 AND s.is_final == 1",
          "date_window": "PRE_INTERVENTION_CONSECUTIVE_GAMES"
        },
        "s1_evaluation_block": {
          "block_name": "S1_CALENDAR_SIM_INTERVENTION",
          "game_count_minimum": 10,
          "simulation_filter": "s.was_simulated == 1 AND s.is_final == 1",
          "date_window": "POST_INTERVENTION_CONSECUTIVE_GAMES"
        }
      },
      "matched_controls": {
        "simulation_engine": "CALENDAR_SIM_ONLY (was_simulated == 1)",
        "quarter_length_minutes": 12,
        "sim_quarter_length_minutes": 12,
        "ace_adaptive_coaching": "LOCKED_DISABLED",
        "roster_stability_rule": "TARGET_PLAYER_MUST_PLAY_MIN_20_MPG; NO_TRADE_NO_INJURY_DNP",
        "opponent_strength_matching": "OPPONENT_DEFENSIVE_RATING_IQR_MATCHED"
      },
      "metrics_evaluation_contract": {
        "primary_metric": {
          "metric_id": "PLAYER_FGA",
          "sql_selector": "b.fg_attempted",
          "expected_direction": "INCREASE",
          "minimum_detectable_delta": 3.0
        },
        "secondary_metrics": [
          {
            "metric_id": "PLAYER_PTS",
            "sql_selector": "b.points",
            "expected_direction": "INCREASE",
            "minimum_detectable_delta": 4.0
          },
          {
            "metric_id": "EXPERIMENTAL_POSSESSION_LOAD_INDEX",
            "sql_selector": "(b.fg_attempted + 0.44*b.ft_attempted + b.turnovers + 0.33*b.assists)",
            "expected_direction": "INCREASE",
            "minimum_detectable_delta": 4.0
          },
          {
            "metric_id": "PLAYER_TS_NATIVE",
            "sql_selector": "b.points / (2.0 * (b.fg_attempted + 0.44 * b.ft_attempted))",
            "expected_direction": "NEUTRAL_TO_SLIGHT_DECREASE",
            "tolerance_band": 0.05
          }
        ]
      },
      "falsification_criteria": {
        "supported_condition": "delta(PLAYER_FGA) >= +3.0 AND delta(EXPERIMENTAL_POSSESSION_LOAD_INDEX) >= +4.0 (p < 0.05)",
        "refuted_condition": "delta(PLAYER_FGA) <= 0.0 OR delta(EXPERIMENTAL_POSSESSION_LOAD_INDEX) <= 0.0",
        "inconclusive_conditions": [
          "Target player injured or played < 20 minutes in >= 20% of block games",
          "Opponent defensive rating difference across blocks > 5.0 points/100",
          "Sample size < 10 completed Calendar Sim games per block"
        ]
      }
    },
