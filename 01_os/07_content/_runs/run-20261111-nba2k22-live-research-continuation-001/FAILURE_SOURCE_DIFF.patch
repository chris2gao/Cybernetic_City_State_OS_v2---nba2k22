+def test_bind_verified_capture_requires_exact_sources_and_fresh_native_clock(tmp_path, monkeypatch):
+    db = tmp_path / "world.sqlite"
+    epoch = {"pid": 7}
+    binding = {"save_id": "save", "worldline_id": "world"}
+    sources = []
+    with sqlite3.connect(db) as conn:
+        conn.executescript("""
+            CREATE TABLE capture_runs(run_id,source_grade,season_id);
+            CREATE TABLE capture_units(unit_id,payload_sha256,unit_status,observed_at,source_key,run_id);
+            CREATE TABLE game_mode_observations(unit_id,today_native_iso_date,today_minutes_since_midnight_raw,mode_raw,period_raw,league_raw);
+        """)
+        for family in ("schedule", "game-mode", "player-skills"):
+            unit = {"unit_id": family, "payload_sha256": SHA, "unit_status": "success", "observed_at": "now",
+                    "source_key": family, "source_grade": "LIVE_READ", "season_id": "2021-22"}
+            conn.execute("INSERT INTO capture_runs VALUES (?,?,?)", (family, "LIVE_READ", "2021-22"))
+            conn.execute("INSERT INTO capture_units VALUES (?,?,?,?,?,?)", (family, SHA, "success", "now", family, family))
+            sources.append({"family": family, "status": "ACQUIRED", "commit_status": "COMMITTED_SUCCESS_VERIFIED", "unit": unit})
+        conn.execute("INSERT INTO game_mode_observations VALUES (?,?,?,?,?,?)", ("game-mode", "2021-11-15", 1170, 1, 29, 0))
+    report = {"status": "COMPLETED_REQUESTED_SOURCES", "game_writes": False, "save_id": "save",
+              "binding_sha256": SHA, "native_save_filename": "MyLEAGUE0005", "process_epoch": epoch, "sources": sources}
+    raw = json.dumps(report).encode()
+    (tmp_path / "refresh-report.json").write_bytes(raw)
+    monkeypatch.setattr(season_cycle_host, "read_binding", lambda *_: (binding, SHA))
+    monkeypatch.setattr(season_cycle_host, "bound_database", lambda *_: db)
+    monkeypatch.setattr(season_cycle_host, "CalendarSimOrchestrator", lambda *_, **__: None)
+    progress = {"today_native_iso_date": "2021-11-15", "today_minutes_since_midnight_raw": 1170,
+                "mode_raw": 1, "period_raw": 29, "league_raw": 0}
+    monkeypatch.setattr(refresh, "_context", lambda _: {"epoch": epoch, "game_progress": progress})
+    host = SeasonCycleHost.__new__(SeasonCycleHost)
+    host.state = {"status": season_cycle_host.HostState.UNBOUND}
+    host._save_state = lambda: None
+    host._append_ledger = lambda _: None
+    pin = sha256(raw).hexdigest()
+    result = host.bind_verified_live_capture(tmp_path, "MyLEAGUE0005", tmp_path, pin, epoch)
+    assert result["status"] == "VERIFIED_BASELINE_BOUND_AUTHORIZATION_PENDING"
+    assert host.state["is_offline_mock"] is False and host.state["baseline_report_sha256"] == pin
+    host.state["status"] = season_cycle_host.HostState.UNBOUND
+    progress["today_minutes_since_midnight_raw"] = 1171
+    with pytest.raises(ValueError, match="VERIFIED_CAPTURE_FRESH_SCENE_MISMATCH"):
+        host.bind_verified_live_capture(tmp_path, "MyLEAGUE0005", tmp_path, pin, epoch)
