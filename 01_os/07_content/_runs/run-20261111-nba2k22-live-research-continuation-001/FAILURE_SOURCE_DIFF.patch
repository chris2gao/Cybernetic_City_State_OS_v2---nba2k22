+@pytest.mark.parametrize("field", ["SHOT_TENDENCY", "UNKNOWN_RAW_BYTE_016"])
+def test_research_role_payload_reaches_real_bridge_with_exact_unknown_grant(field):
+    from decision_batch_bridge import DecisionBatchBridge
+    from role_batches import ActionIntent, BatchContext, RoleActionBatch
+    from role_capabilities import RoleCapabilityProfile
+    slot = resolve_tendency_slot(field)
+    bridge = DecisionBatchBridge()
+    context = BatchContext("world", "MyLEAGUE0005", "generation", "2021-22", "REGULARSEASON", "snapshot", bridge.service.version)
+    granted = ((101, slot.native_key),) if not slot.named else ()
+    profile = RoleCapabilityProfile("GM", "actor", (1,), "world", "MyLEAGUE0005", "generation", "2021-22",
+                                    "REGULARSEASON", "snapshot", allowed_actions=frozenset({"PLAYER.EDIT.TENDENCY_BATCH"}),
+                                    native_tendency_write_grants=granted)
+    intent = ActionIntent.decided("intent", "actor", "PLAYER.EDIT.TENDENCY_BATCH",
+                                   {"team_id":1,"player_id":101,"expected_before":50,"values":{slot.native_key:51}})
+    batch = RoleActionBatch("batch", context, (intent,))
+    result = bridge.bridge_batch(batch, profiles=(profile,), phase_grants={("actor",intent.action_id)}, expected_pid=7)
+    assert not result.unsupported_intents and result.has_executable_batch
+    assert result.bulk_batch.intents[0].field_id == slot.native_key
+    assert result.bulk_batch.intents[0].expected_before == 50
