+            if value is not None:where.append(column+'=?');args.append(value)
+        if current_core_only:where.append("s.current_core_roster_status='CURRENT_CORE_ROSTER'")
+        if valid_only:where.append('o.native_float_result_f32 IS NOT NULL')
+        rows=[dict(row) for row in c.execute('''SELECT o.*,s.source_player_index,s.native_unique_id_raw,s.preserved_id_raw,s.observed_name,s.name_status,s.native_team_id,s.current_core_roster_status,s.current_roster_slot,s.canonical_link_status FROM native_player_overall_observations o JOIN native_player_sources s ON s.player_source_id=o.source_player_id AND s.unit_id=o.unit_id WHERE '''+' AND '.join(where)+' ORDER BY s.source_player_index LIMIT ?',args+[limit+1])];more=len(rows)>limit;rows=rows[:limit]
+        mode=c.execute('SELECT * FROM game_mode_observations WHERE unit_id=?',(unit['unit_id'],)).fetchone();count=c.execute('SELECT count(*) FROM native_player_overall_observations WHERE unit_id=?',(unit['unit_id'],)).fetchone()[0]
+        return {'status':'OBSERVED','source':dict(unit),'game_mode':dict(mode) if mode else None,'source_player_count':count,'current_core_only':current_core_only,'valid_only':valid_only,'records':rows,'has_more':more,'next_after_index':rows[-1]['source_player_index'] if more else None,'qualification':overall_profile['limits'],'display_candidate_policy':'Nearest-even is assumed, not observed game-thread rounding. Only rounding_independent_integer is invariant where exactness is proved. UI acceptance remains unproved; legacy overall_raw is unchanged.'}
