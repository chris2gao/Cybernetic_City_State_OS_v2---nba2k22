{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:citystate:run-manifest-calibration:v1",
  "title": "City-State run manifest calibration contract",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "human_gate",
    "outputs",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "run_manifest.calibration.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{3}-[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "completed",
        "blocked"
      ]
    },
    "human_gate": {
      "type": "boolean"
    },
    "outputs": {
      "type": "object",
      "required": [
        "report_ref",
        "artifact_refs"
      ],
      "properties": {
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "required_pass",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2}$"
          },
          "required_pass": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
