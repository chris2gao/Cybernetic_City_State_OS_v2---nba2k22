{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Capability Card",
  "type": "object",
  "properties": {
    "did": {
      "type": "string",
      "description": "特工唯一身份标识符 (e.g., did:agent:engine-b)"
    },
    "agent_role": {
      "type": "string",
      "enum": ["OS_Coordinator", "Execution_Agent", "Sandbox_Verification_Officer", "Engine_B_Arbiter", "Institute_Agent"]
    },
    "hardware_tier": {
      "type": "string",
      "enum": ["Flash_Tier", "Pro_Tier", "Opus_Tier"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_context_window": {
      "type": "integer",
      "description": "模型物理支持的最大上下文 Token 窗口（如 128000 或 1048576），供调度器参考。"
    },
    "verifiable_credentials": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string", "description": "System_Principal 或被授权的 OS_Coordinator" },
        "signature": { "type": "string", "description": "由 Issuer 签发的非对称加密签名，证明该模型的实际算力级别。" },
        "delegated_campaign_token": { "type": "string", "description": "(可选) Macaroon 委托令牌。允许 OS_Coordinator 在特定战役内批量高频签发低阶（Flash_Tier）名片，防止单点签名 DDoS 瓶颈。" }
      },
      "required": ["issuer", "signature"]
    }
  },
  "required": ["did", "agent_role", "hardware_tier", "capabilities", "max_context_window", "verifiable_credentials"]
}
