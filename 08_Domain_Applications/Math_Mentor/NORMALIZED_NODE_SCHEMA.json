{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chris2gao/Cybernetic_City_State_OS_v2---teacher/schemas/math-mentor-normalized-node-v1.json",
  "title": "Math Mentor normalized node",
  "description": "A read-only structural adapter result. Validation does not establish mathematical truth, teaching admission, or write authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "schema_era",
    "parse_status",
    "identity",
    "content",
    "routing",
    "lifecycle",
    "mathematical_truth_status",
    "consumer_allowed",
    "evidence_limits"
  ],
  "properties": {
    "schema_version": {"const": "math_mentor.normalized_node.v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "schema_era": {"enum": ["E1", "E2", "E3", "E4", "unknown"]},
    "parse_status": {"const": "parsed"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "strict_id", "locator", "locator_hits"],
      "properties": {
        "status": {"enum": ["resolved", "missing", "conflict"]},
        "strict_id": {"type": ["string", "null"]},
        "locator": {"type": ["string", "null"]},
        "locator_hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locator", "value"],
            "properties": {
              "locator": {"type": "string"},
              "value": {"type": "string"}
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "title_locator", "sub_topics", "subtopics_locator"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "title_locator": {"type": ["string", "null"]},
        "sub_topics": {"type": "array"},
        "subtopics_locator": {"type": ["string", "null"]}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "math_lane", "mode_routing_status"],
      "properties": {
        "mode": {"type": ["string", "null"]},
        "math_lane": {"type": ["string", "null"]},
        "mode_routing_status": {"type": ["string", "null"]}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_definition_status",
        "prerequisites_status",
        "mapping_boundary_status",
        "validation_status",
        "teaching_ready",
        "teaching_readiness_status",
        "bridge_readiness_status",
        "coordinator_consumable",
        "independent_teaching_node",
        "disposition",
        "canonical_target_id"
      ],
      "properties": {
        "formal_definition_status": {},
        "prerequisites_status": {},
        "mapping_boundary_status": {},
        "validation_status": {},
        "teaching_ready": {},
        "teaching_readiness_status": {},
        "bridge_readiness_status": {},
        "coordinator_consumable": {},
        "independent_teaching_node": {},
        "disposition": {},
        "canonical_target_id": {}
      }
    },
    "mathematical_truth_status": {"const": "not_evaluated"},
    "consumer_allowed": {"const": false},
    "evidence_limits": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "not_mathematical_validation"}},
        {"contains": {"const": "not_teaching_admission"}},
        {"contains": {"const": "not_mutation_authority"}}
      ]
    }
  }
}
