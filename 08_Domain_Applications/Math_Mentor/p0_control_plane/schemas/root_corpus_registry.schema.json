{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "root_corpus_registry.schema.json",
  "title": "Math Mentor Root Corpus Registry",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "source_head",
    "namespace_uuid",
    "tracked_scope_path_set_sha256",
    "discovery_policy",
    "summary",
    "nodes",
    "excluded_assets",
    "runtime_activation_performed",
    "payload_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generator_version": {"type": "string"},
    "namespace_uuid": {"type": "string", "format": "uuid"},
    "scope_root": {"type": "string"},
    "db_root": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "tracked_scope_path_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "discovery_policy": {"type": "object"},
    "summary": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_uuid",
          "bootstrap_uuid_seed",
          "path",
          "sha256",
          "parsed",
          "schema_era",
          "strict_identity",
          "typed_aliases",
          "registry_status",
          "runtime_allowed"
        ],
        "properties": {
          "canonical_uuid": {"type": "string", "format": "uuid"},
          "bootstrap_uuid_seed": {
            "type": "object",
            "required": ["kind", "value", "immutable_after_materialization"]
          },
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parsed": {"const": true},
          "schema_era": {"type": "string"},
          "strict_identity": {
            "type": "object",
            "required": ["status", "value", "locator", "locator_hits"]
          },
          "typed_aliases": {"type": "array", "items": {"$ref": "#/$defs/typedAlias"}},
          "path_identity_relation": {"type": "string"},
          "observed_statuses": {"type": "object"},
          "registry_status": {"type": "string"},
          "blockers": {"type": "array", "items": {"type": "string"}},
          "runtime_allowed": {"const": false}
        }
      }
    },
    "excluded_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_uuid", "path", "reason", "parsed_as_node", "identity_resolution_allowed"],
        "properties": {
          "asset_uuid": {"type": "string", "format": "uuid"},
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "reason": {"type": "string"},
          "parsed_as_node": {"const": false},
          "identity_resolution_allowed": {"const": false}
        }
      }
    },
    "runtime_activation_performed": {"const": false},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "typedAlias": {
      "type": "object",
      "required": [
        "alias_type",
        "value",
        "namespace_or_version",
        "status",
        "source",
        "resolution_ref"
      ],
      "properties": {
        "alias_type": {"enum": ["root_path", "root_filename", "domain_id"]},
        "value": {"type": "string"},
        "namespace_or_version": {},
        "status": {"enum": ["observed"]},
        "source": {
          "type": "object",
          "required": ["path", "json_pointer", "content_sha256"],
          "properties": {
            "path": {"type": "string"},
            "json_pointer": {"type": ["string", "null"]},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "resolution_ref": {"type": ["string", "null"]}
      }
    }
  }
}
