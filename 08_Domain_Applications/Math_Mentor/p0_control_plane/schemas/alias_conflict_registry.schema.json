{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alias_conflict_registry.schema.json",
  "title": "Math Mentor Alias Conflict Registry",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "source_head",
    "namespace_uuid",
    "stage0_evidence_policy",
    "summary",
    "conflicts",
    "runtime_activation_performed",
    "payload_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generator_version": {"type": "string"},
    "namespace_uuid": {"type": "string", "format": "uuid"},
    "stage0_evidence_policy": {"type": "object"},
    "summary": {"type": "object"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "conflict_uuid",
          "type",
          "severity",
          "status",
          "requires_human",
          "subjects",
          "evidence",
          "prohibited_resolution_methods",
          "allowed_decisions",
          "blocking_scopes",
          "resolution_ref"
        ],
        "properties": {
          "conflict_uuid": {"type": "string", "format": "uuid"},
          "type": {"type": "string"},
          "severity": {"enum": ["warning", "error", "blocker"]},
          "status": {"enum": ["open", "diagnostic", "quarantined", "resolved"]},
          "requires_human": {"type": "boolean"},
          "subjects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["subject_uuid"]
            }
          },
          "evidence": {"type": "array", "items": {"type": "object"}},
          "prohibited_resolution_methods": {
            "type": "array",
            "contains": {"const": "filename_suffix"}
          },
          "allowed_decisions": {"type": "array", "items": {"type": "string"}},
          "blocking_scopes": {"type": "array", "items": {"type": "string"}},
          "resolution_ref": {"type": ["string", "null"]}
        }
      }
    },
    "runtime_activation_performed": {"const": false},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
