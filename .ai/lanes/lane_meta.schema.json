{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citystate-cooperative-lane-meta-v1",
  "title": "Cooperative C0/C1 lane metadata",
  "description": "Instance-local descriptive metadata. It grants no authority or identity authentication.",
  "type": "object",
  "required": [
    "lane_instance_id",
    "environment_class",
    "protocol_role",
    "load_profile_id",
    "opened_at",
    "lane_protocol_epoch"
  ],
  "properties": {
    "lane_instance_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*-[0-9a-f]{6,32}$"},
    "environment_class": {"enum": ["claude_desktop", "chatgpt_web", "codex_desktop", "codex_cli", "claude_code_cli"]},
    "protocol_role": {"enum": ["human_speaker", "foreground_review_and_task_dispatch", "backend_execution_and_handoff"]},
    "load_profile_id": {"enum": ["foreground_planner", "foreground_independent_reviewer", "backend_executor"]},
    "opened_at": {"type": "string", "format": "date-time"},
    "lane_protocol_epoch": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "transport": {
      "description": "Optional transport selector. Omitted metadata retains the historical git default.",
      "enum": ["git", "local"]
    }
  },
  "additionalProperties": false
}
