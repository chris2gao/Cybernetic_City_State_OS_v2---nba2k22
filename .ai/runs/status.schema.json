{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citystate.local/schemas/agent-runner-status.v1.json",
  "title": "CityState agent runner status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "engine", "tier", "state", "started_at", "pid", "session_id",
    "worktree", "base_branch", "base_head", "last_heartbeat", "exit_code", "handoff_ref"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "engine": {"enum": ["codex", "claude"]},
    "tier": {"type": "string"},
    "state": {"enum": ["starting", "running", "validating", "done", "failed", "stopped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "pid": {"type": "integer", "minimum": 0},
    "session_id": {"type": ["string", "null"]},
    "worktree": {"type": "string"},
    "base_branch": {"type": "string"},
    "base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "last_heartbeat": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "handoff_ref": {"type": ["string", "null"]}
  }
}
