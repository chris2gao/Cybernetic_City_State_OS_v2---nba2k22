{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-mentor-certified-pilot-validation-v1",
  "type": "object",
  "required": ["schema_version", "status", "source_head", "correction_business_head", "sandbox_evaluator", "p0_unittest", "p0_consolidated_validator", "artifact_validation", "activation", "remaining_gates"],
  "properties": {
    "schema_version": {"const": "math_mentor.certified_pilot_validation.v1"},
    "status": {"const": "passed_human_accepted_pending_publication"},
    "source_head": {"const": "b3ee031488be07748b1cbdfc19b8926b6caaa6db"},
    "correction_business_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sandbox_evaluator": {"type": "object", "minProperties": 4},
    "p0_unittest": {"type": "object", "required": ["executed", "passed", "failed"]},
    "p0_consolidated_validator": {"type": "object", "required": ["invocations", "outer_outputs_byte_identical", "consumer_allowed"]},
    "artifact_validation": {"type": "object"},
    "activation": {"type": "object"},
    "remaining_gates": {"type": "array"}
  },
  "additionalProperties": true
}
