{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-transition-proof-v2",
  "type": "object",
  "required": ["schema_version", "request_id", "result", "protocol_release_head", "policy_sha256", "fresh_event_validation_sha256", "raw_state_status", "normalized_from_state", "derived_transition_id", "derived_to_state", "active_state_anchor", "evidence", "violations", "authorization_granted_by_validator"],
  "properties": {
    "schema_version": {"const": "human_ai.communication_transition_proof.v2"},
    "request_id": {"type": ["string", "null"]},
    "result": {"enum": ["pass", "fail"]},
    "protocol_release_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fresh_event_validation_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_state_status": {"type": ["string", "null"]},
    "normalized_from_state": {"type": ["string", "null"]},
    "derived_transition_id": {"type": ["string", "null"]},
    "derived_to_state": {"type": ["string", "null"]},
    "active_state_anchor": {"type": ["object", "null"]},
    "evidence": {"type": "object"},
    "violations": {"type": "array"},
    "authorization_granted_by_validator": {"const": false}
  },
  "additionalProperties": false
}
