{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-transition-request-v2",
  "type": "object",
  "required": ["schema_version", "request_id", "event_ref", "state_ref", "pointer_ref", "validation_artifact_ref"],
  "properties": {
    "schema_version": {"const": "human_ai.communication_transition_request.v2"},
    "request_id": {"type": "string", "minLength": 1},
    "event_ref": {"$ref": "#/$defs/immutable_ref"},
    "state_ref": {"$ref": "#/$defs/immutable_ref"},
    "pointer_ref": {"oneOf": [{"$ref": "#/$defs/immutable_ref"}, {"type": "null"}]},
    "validation_artifact_ref": {"oneOf": [{"$ref": "#/$defs/immutable_ref"}, {"type": "null"}]},
    "claimed_transition_id": {"type": ["string", "null"]},
    "claimed_event_id": {"type": ["string", "null"]},
    "claimed_task_id": {"type": ["string", "null"]},
    "claimed_event_type": {"type": ["string", "null"]},
    "claimed_event_class": {"enum": ["C1", "C2", null]},
    "claimed_from_state": {"type": ["string", "null"]},
    "claimed_to_state": {"type": ["string", "null"]},
    "claimed_protocol_release_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "claimed_validation_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "immutable_ref": {
      "type": "object",
      "required": ["kind", "path", "content_sha256"],
      "properties": {
        "kind": {"enum": ["git_blob", "test_fixture_blob"]},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "test_only": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "git_blob"}}},
          "then": {"required": ["commit"], "not": {"required": ["test_only"]}}
        },
        {
          "if": {"properties": {"kind": {"const": "test_fixture_blob"}}},
          "then": {"required": ["test_only"]},
          "else": {"required": ["commit"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
