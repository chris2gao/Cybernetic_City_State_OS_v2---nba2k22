{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-inherited-fixture-coverage-map-v1",
  "type": "object",
  "required": ["schema_version", "prior_suite_ref", "mappings"],
  "properties": {
    "schema_version": {"const": "human_ai.communication_inherited_fixture_coverage_map.v1"},
    "prior_suite_ref": {
      "type": "object",
      "required": ["kind", "commit", "path", "content_sha256"],
      "properties": {
        "kind": {"const": "git_blob"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prior_case_id", "current_case_id", "template_case_id", "mapping_kind", "rationale"],
        "properties": {
          "prior_case_id": {"type": "string", "minLength": 1},
          "current_case_id": {"type": "string", "pattern": "^legacy_migrated__[A-Za-z0-9_.-]+$"},
          "template_case_id": {"type": "string", "minLength": 1},
          "mapping_kind": {"const": "one_to_one"},
          "rationale": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
