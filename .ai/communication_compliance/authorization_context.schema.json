{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-authorization-context-v1",
  "type": "object",
  "required": [
    "schema_version",
    "context_id",
    "injection_source",
    "test_only",
    "issuer",
    "decision",
    "task_id",
    "event_id",
    "transition_id",
    "action",
    "target",
    "protocol_head",
    "revoked",
    "replay_protected"
  ],
  "properties": {
    "schema_version": {"const": "human_ai.communication_authorization_context.v1"},
    "context_id": {"type": "string", "minLength": 1},
    "injection_source": {"enum": ["trusted_external_host", "deterministic_test_fixture"]},
    "test_only": {"type": "boolean"},
    "issuer": {"const": "Human"},
    "decision": {"const": "allow"},
    "task_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "protocol_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "revoked": {"const": false},
    "replay_protected": {"const": true}
  },
  "additionalProperties": false
}
