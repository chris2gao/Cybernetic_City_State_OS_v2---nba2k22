{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-actor-origin-context-v2",
  "type": "object",
  "required": ["schema_version", "context_id", "injection_source", "test_only", "provider", "occupied_role", "event_id", "task_id", "transition_id", "protocol_release_head", "event_input_sha256", "authenticated_channel", "replay_protected"],
  "properties": {
    "schema_version": {"const": "human_ai.communication_actor_origin_context.v2"},
    "context_id": {"type": "string", "minLength": 1},
    "injection_source": {"enum": ["trusted_external_host", "deterministic_test_fixture"]},
    "test_only": {"type": "boolean"},
    "provider": {"enum": ["Human", "ChatGPT", "Claude", "Codex", "Claude Code"]},
    "occupied_role": {"enum": ["human_speaker", "foreground_review_and_task_dispatch", "backend_execution_and_handoff"]},
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "protocol_release_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "event_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authenticated_channel": {"const": true},
    "replay_protected": {"const": true}
  },
  "additionalProperties": false
}
