{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-drift-ledger-v2",
  "type": "object",
  "required": ["schema_version", "policy_version", "ledger_revision", "previous_ledger_ref", "append_only", "privacy", "recurrence_policy", "records"],
  "properties": {
    "schema_version": {"const": "human_ai.communication_drift_ledger.v2"},
    "policy_version": {"const": "human_ai.communication_material_event_policy.v3"},
    "ledger_revision": {"type": "integer", "minimum": 1},
    "previous_ledger_ref": {"$ref": "#/$defs/git_blob_ref"},
    "append_only": {"const": true},
    "privacy": {
      "type": "object",
      "required": ["contains_private_reasoning", "contains_secret_content"],
      "properties": {
        "contains_private_reasoning": {"const": false},
        "contains_secret_content": {"const": false}
      },
      "additionalProperties": false
    },
    "recurrence_policy": {
      "type": "object",
      "required": ["threshold", "requirement"],
      "properties": {
        "threshold": {"const": 2},
        "requirement": {"const": "matching_immutable_negative_fixture_or_deterministic_impossibility_with_foreground_review"}
      },
      "additionalProperties": false
    },
    "records": {"type": "array", "items": {"$ref": "drift_record.schema.json"}}
  },
  "$defs": {
    "git_blob_ref": {
      "type": "object",
      "required": ["kind", "commit", "path", "content_sha256"],
      "properties": {
        "kind": {"const": "git_blob"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"const": ".ai/COMMUNICATION_DRIFT_LEDGER.yml"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
