{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-ai-communication-bootstrap-receipt-v1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "protocol_head",
    "provider",
    "occupied_role",
    "wire_schema",
    "loaded_files",
    "inherited_on_demand",
    "authority_boundary",
    "onboarding_answers"
  ],
  "properties": {
    "schema_version": {"const": "human_ai.communication_bootstrap_receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "protocol_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider": {"enum": ["ChatGPT", "Claude", "Codex", "Claude Code"]},
    "occupied_role": {
      "enum": ["foreground_review_and_task_dispatch", "backend_execution_and_handoff"]
    },
    "wire_schema": {"enum": ["chatgpt_to_codex_v1", "codex_to_chatgpt_v1"]},
    "loaded_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/loaded_file"}
    },
    "inherited_on_demand": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "trigger", "loaded"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "loaded": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "authority_boundary": {
      "type": "object",
      "required": ["receipt_is_authorization", "protected_actions_need_external_human"],
      "properties": {
        "receipt_is_authorization": {"const": false},
        "protected_actions_need_external_human": {"const": true}
      },
      "additionalProperties": false
    },
    "onboarding_answers": {
      "type": "object",
      "required": [
        "repository_and_source_state",
        "role_and_authority",
        "always_loaded_files",
        "inherited_on_demand_files",
        "workflow_state_and_signal",
        "non_null_refs",
        "human_gate",
        "next_action_and_response_shape",
        "communication_channels",
        "execution_recommendation",
        "independent_expression",
        "expression_preservation",
        "expression_authority_boundary",
        "drift_correction",
        "role_and_wire_schema",
        "mixed_recipient_resolution",
        "bootstrap_receipt_capability_boundary",
        "c2_external_authority_origin"
      ],
      "properties": {
        "repository_and_source_state": {"const": true},
        "role_and_authority": {"const": true},
        "always_loaded_files": {"const": true},
        "inherited_on_demand_files": {"const": true},
        "workflow_state_and_signal": {"const": true},
        "non_null_refs": {"const": true},
        "human_gate": {"const": true},
        "next_action_and_response_shape": {"const": true},
        "communication_channels": {"const": true},
        "execution_recommendation": {"const": true},
        "independent_expression": {"const": true},
        "expression_preservation": {"const": true},
        "expression_authority_boundary": {"const": true},
        "drift_correction": {"const": true},
        "role_and_wire_schema": {"const": true},
        "mixed_recipient_resolution": {"const": true},
        "bootstrap_receipt_capability_boundary": {"const": true},
        "c2_external_authority_origin": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "loaded_file": {
      "type": "object",
      "required": ["commit", "path", "content_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"enum": ["ChatGPT", "Claude"]}}},
      "then": {
        "properties": {
          "occupied_role": {"const": "foreground_review_and_task_dispatch"},
          "wire_schema": {"const": "chatgpt_to_codex_v1"}
        }
      }
    },
    {
      "if": {"properties": {"provider": {"enum": ["Codex", "Claude Code"]}}},
      "then": {
        "properties": {
          "occupied_role": {"const": "backend_execution_and_handoff"},
          "wire_schema": {"const": "codex_to_chatgpt_v1"}
        }
      }
    }
  ],
  "additionalProperties": false
}
